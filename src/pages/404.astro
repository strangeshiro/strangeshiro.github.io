---
import Base from "../layouts/Base.astro";
---
<Base title="404 · Page not found" description="This page does not exist.">
  <section class="container nf">
    <p class="label">Error 404</p>
    <h1>Nothing <em>here.</em></h1>
    <a class="button primary" href="/">Go to the home page</a>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 32px; padding-block: 96px 0; justify-items: start; }
  .nf h1 em { color: var(--accent); }
</style>
